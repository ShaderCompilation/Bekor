# Copy to .env and fill in. Never commit .env. Values here are development placeholders only.
# Validation lives in apps/api/src/env.ts and apps/worker/src/env.ts; a missing or invalid
# variable stops the process with one message listing every problem (values are never printed).

# --- Shared ---
# development | test | production (production requires an https:// API_ORIGIN)
NODE_ENV=development
# Local compose postgres (infra/compose/compose.yaml publishes it on 127.0.0.1:${POSTGRES_PORT}).
DATABASE_URL=postgresql://bekor:bekor@127.0.0.1:55432/bekor

# --- API (apps/api) ---
PORT=3000
# Origin only: scheme://host[:port], no path, no credentials.
API_ORIGIN=http://localhost:3000
# Required, at least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# true | false (default false)
REGISTRATION_ENABLED=false

# --- Judging worker (apps/worker) ---
# Required by the worker only. A PRIVATE, isolated Judge0 service (http(s), no credentials/query);
# never an arbitrary public endpoint. Inside the compose runner profile the default is
# http://judge0-server:2358/. From the host there is no route to it (runner network is internal).
JUDGE0_URL=
# Optional. Sent as X-Auth-Token; also becomes Judge0's AUTHN_TOKEN in the compose runner profile.
JUDGE0_AUTH_TOKEN=
# Optional. Enables GET /health on WORKER_HEALTH_HOST:WORKER_HEALTH_PORT (default host 127.0.0.1).
WORKER_HEALTH_PORT=
WORKER_HEALTH_HOST=

# --- Compose only (infra/compose/compose.yaml) ---
POSTGRES_PORT=55432
POSTGRES_PASSWORD=bekor
API_PORT=3000
# Runner profile internal services (internal network only; change for anything shared).
JUDGE0_POSTGRES_PASSWORD=
JUDGE0_REDIS_PASSWORD=

# --- Tests ---
# Admin connection used by `pnpm test:integration` to create throwaway databases (needs CREATEDB).
# TEST_DATABASE_URL=postgresql://bekor:bekor@127.0.0.1:55432/postgres
