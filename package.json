{
  "name": "bekor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:runner": "vitest run --project runner",
    "db:migrate": "pnpm --filter @bekor/db migrate",
    "content:validate": "pnpm --filter @bekor/exercises validate",
    "dev:web": "pnpm --filter @bekor/web dev",
    "dev:backend": "pnpm --parallel --filter @bekor/api --filter @bekor/worker exec tsx --env-file=../../.env src/main.ts",
    "test:e2e": "playwright test",
    "check:web-bundle": "node scripts/check-web-bundle.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.14",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
