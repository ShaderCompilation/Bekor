  "referenceSolutions": {
    "javascript": "export function rangeSumUpdates(values          , operations                       )                    {\n  const current = values.slice();\n  const tree           = Array(values.length + 1).fill(0);\n  function add(index        , delta        )       {\n    for (let i = index + 1; i < tree.length; i += i & -i) tree[i] += delta;\n  }\n  function prefix(count        )         {\n    let total = 0;\n    for (let i = count; i > 0; i -= i & -i) total += tree[i];\n    return total;\n  }\n  for (let i = 0; i < current.length; i++) add(i, current[i]);\n  const results                    = [];\n  for (const op of operations) {\n    const first = op[1]          , second = op[2]          ;\n    if (op[0] === 'set') {\n      add(first, second - current[first]);\n      current[first] = second;\n      results.push(null);\n    } else {\n      results.push(prefix(second + 1) - prefix(first));\n    }\n  }\n  return results;\n}\n",
    "typescript": "export function rangeSumUpdates(values: number[], operations: (string | number)[][]): (number | null)[] {\n  const current = values.slice();\n  const tree: number[] = Array(values.length + 1).fill(0);\n  function add(index: number, delta: number): void {\n    for (let i = index + 1; i < tree.length; i += i & -i) tree[i] += delta;\n  }\n  function prefix(count: number): number {\n    let total = 0;\n    for (let i = count; i > 0; i -= i & -i) total += tree[i];\n    return total;\n  }\n  for (let i = 0; i < current.length; i++) add(i, current[i]);\n  const results: (number | null)[] = [];\n  for (const op of operations) {\n    const first = op[1] as number, second = op[2] as number;\n    if (op[0] === 'set') {\n      add(first, second - current[first]);\n      current[first] = second;\n      results.push(null);\n    } else {\n      results.push(prefix(second + 1) - prefix(first));\n    }\n  }\n  return results;\n}\n"
  },
  "explanation": "Keep a Fenwick tree of partial sums and a separate copy of the current array. Build it by adding each initial value. For a set operation, add the assigned value minus the old value to the tree, then replace the stored value. An inclusive range sum equals prefix(right + 1) minus prefix(left), where prefix counts elements from the start. With n initial values and q operations, construction takes O(n log(n + 1)) time and each operation O(log(n + 1)), so total time is O((n + q) log(n + 1)). Auxiliary storage is O(n), plus O(q) for the returned results. The documented bounds keep each sum within 800000000 in magnitude and produce at most 500 scalar results."
