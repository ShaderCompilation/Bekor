    "javascript": "export function setMatrixZeroes(matrix            )             {\nconst rows=new Set        (),cols=new Set        ();matrix.forEach((row,r)=>row.forEach((v,c)=>{if(v===0){rows.add(r);cols.add(c);}}));return matrix.map((row,r)=>row.map((v,c)=>rows.has(r)||cols.has(c)?0:v));\n}\n",
    "typescript": "export function setMatrixZeroes(matrix: number[][]): number[][] {\nconst rows=new Set<number>(),cols=new Set<number>();matrix.forEach((row,r)=>row.forEach((v,c)=>{if(v===0){rows.add(r);cols.add(c);}}));return matrix.map((row,r)=>row.map((v,c)=>rows.has(r)||cols.has(c)?0:v));\n}\n"
