  "referenceSolutions": {
    "javascript": "export function countTargetSubarrays(values, target) {\n  const counts = new Map([[0, 1]]);\n  let prefix = 0, result = 0;\n  for (const value of values) {\n    prefix += value;\n    result += counts.get(prefix - target) ?? 0;\n    counts.set(prefix, (counts.get(prefix) ?? 0) + 1);\n  }\n  return result;\n}\n",
    "typescript": "export function countTargetSubarrays(values: number[], target: number): number {\n  const counts = new Map<number, number>([[0, 1]]);\n  let prefix = 0, result = 0;\n  for (const value of values) {\n    prefix += value;\n    result += counts.get(prefix - target) ?? 0;\n    counts.set(prefix, (counts.get(prefix) ?? 0) + 1);\n  }\n  return result;\n}\n"
  },
  "explanation": "For each prefix sum p, every earlier prefix equal to p minus target starts a valid subarray. Add its frequency before recording p to exclude empty subarrays. The empty prefix has frequency one. Expected time and space are O(n)."
}
