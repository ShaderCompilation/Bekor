  "referenceSolutions": {
    "javascript": "export function generateParenthesis(n        )           {\nconst out         =[];function visit(s       ,open       ,close       ){if(close===n){out.push(s);return;}if(open<n)visit(s+\"(\",open+1,close);if(close<open)visit(s+\")\",open,close+1);}visit(\"\",0,0);return out;\n}\n",
    "typescript": "export function generateParenthesis(n: number): string[] {\nconst out:string[]=[];function visit(s:string,open:number,close:number){if(close===n){out.push(s);return;}if(open<n)visit(s+\"(\",open+1,close);if(close<open)visit(s+\")\",open,close+1);}visit(\"\",0,0);return out;\n}\n"
  },
  "explanation": "Backtracking maintains prefix balance and emits only valid completions. Opening-first traversal yields lexicographic order; time is proportional to output size."
