    "javascript": "export function designInMemoryFileSystem(operations              )                           {\nconst dirs=new Set(['/']),files=new Map               ();function parent(p       )       {return p.slice(0,p.lastIndexOf('/'))||'/';}return operations.map(([op,p,text])=>{if(op==='mkdir'){let path='';for(const part of p.split('/').filter(Boolean)){path+='/'+part;dirs.add(path);}return null;}if(op==='addContentToFile'){files.set(p,(files.get(p)??'')+text);return null;}if(op==='readContentFromFile')return files.get(p) ;if(files.has(p))return [p.slice(p.lastIndexOf('/')+1)];const out=new Set        ();for(const path of [...dirs,...files.keys()])if(path!==p&&parent(path)===p)out.add(path.slice(path.lastIndexOf('/')+1));return [...out].sort();});\n}\n",
    "typescript": "export function designInMemoryFileSystem(operations: (string)[][]): (string|string[]|null)[] {\nconst dirs=new Set(['/']),files=new Map<string,string>();function parent(p:string):string{return p.slice(0,p.lastIndexOf('/'))||'/';}return operations.map(([op,p,text])=>{if(op==='mkdir'){let path='';for(const part of p.split('/').filter(Boolean)){path+='/'+part;dirs.add(path);}return null;}if(op==='addContentToFile'){files.set(p,(files.get(p)??'')+text);return null;}if(op==='readContentFromFile')return files.get(p)!;if(files.has(p))return [p.slice(p.lastIndexOf('/')+1)];const out=new Set<string>();for(const path of [...dirs,...files.keys()])if(path!==p&&parent(path)===p)out.add(path.slice(path.lastIndexOf('/')+1));return [...out].sort();});\n}\n"
