  "referenceSolutions": {
    "javascript": "export function sudokuSolver(board           )            {\nconst a=board.map(row=>[...row]),rows=Array(9).fill(0),cols=Array(9).fill(0),boxes=Array(9).fill(0);\nfor(let r=0;r<9;r++)for(let c=0;c<9;c++)if(a[r][c]!=='.'){const bit=1<<Number(a[r][c]),b=Math.floor(r/3)*3+Math.floor(c/3);rows[r]|=bit;cols[c]|=bit;boxes[b]|=bit;}\nfunction fill(pos       )        {while(pos<81&&a[Math.floor(pos/9)][pos%9]!=='.')pos++;if(pos===81)return true;const r=Math.floor(pos/9),c=pos%9,b=Math.floor(r/3)*3+Math.floor(c/3),used=rows[r]|cols[c]|boxes[b];for(let v=1;v<=9;v++){const bit=1<<v;if((used&bit)!==0)continue;a[r][c]=String(v);rows[r]|=bit;cols[c]|=bit;boxes[b]|=bit;if(fill(pos+1))return true;rows[r]^=bit;cols[c]^=bit;boxes[b]^=bit;a[r][c]='.';}return false;}fill(0);return a;\n}",
    "typescript": "export function sudokuSolver(board:string[][]):string[][] {\nconst a=board.map(row=>[...row]),rows=Array(9).fill(0),cols=Array(9).fill(0),boxes=Array(9).fill(0);\nfor(let r=0;r<9;r++)for(let c=0;c<9;c++)if(a[r][c]!=='.'){const bit=1<<Number(a[r][c]),b=Math.floor(r/3)*3+Math.floor(c/3);rows[r]|=bit;cols[c]|=bit;boxes[b]|=bit;}\nfunction fill(pos:number):boolean{while(pos<81&&a[Math.floor(pos/9)][pos%9]!=='.')pos++;if(pos===81)return true;const r=Math.floor(pos/9),c=pos%9,b=Math.floor(r/3)*3+Math.floor(c/3),used=rows[r]|cols[c]|boxes[b];for(let v=1;v<=9;v++){const bit=1<<v;if((used&bit)!==0)continue;a[r][c]=String(v);rows[r]|=bit;cols[c]|=bit;boxes[b]|=bit;if(fill(pos+1))return true;rows[r]^=bit;cols[c]^=bit;boxes[b]^=bit;a[r][c]='.';}return false;}fill(0);return a;\n}"
  },
  "explanation": "Row, column and box bitmasks reject forbidden digits in constant time. Depth-first search visits the first blank in row-major order and tries digits ascending, so the first completion is lexicographically smallest. At most 40 blanks are permitted. Worst-case search is O(9 to the blanks); storage is bounded by the board and recursion depth."
}
